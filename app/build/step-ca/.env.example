# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=polaris

# Docker image (source-built: app/images/polaris/Dockerfile)
IMAGE=localhost/polaris:0.16.1

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true
# === STEP-CA ENVIRONMENT ===
VIRTUAL_HOST=polaris.example.com
LETSENCRYPT_HOST=polaris.example.com
LETSENCRYPT_EMAIL=admin@example.com
VIRTUAL_PORT=5050