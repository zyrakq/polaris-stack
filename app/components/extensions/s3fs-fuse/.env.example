# === S3FS-FUSE EXTENSION (music library on RustFS) ===
# s3fs endpoint for the RustFS S3 API (path-style; RustFS is reachable on
# the external step-ca-network)
S3FS_ENDPOINT=http://rustfs:9000

# Bucket mounted at /music
S3FS_BUCKET=polaris-music

# Extra s3fs mount options; when empty the entrypoint applies
# -o allow_other,uid=1000,gid=1000
S3FS_ARGS=-o allow_other,uid=1000,gid=1000

# RustFS credentials (never commit real values; they live only in the
# gitignored .env)
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Image tags for the s3fs-enabled builds (built inline from ${IMAGE} at
# compose build time; distinct from the source-built localhost/polaris
# image so a rebuild never clobbers it)
POLARIS_S3FS_IMAGE=localhost/polaris-s3fs:0.16.1
POLARIS_SEED_S3FS_IMAGE=localhost/polaris-seed-s3fs:0.16.1
